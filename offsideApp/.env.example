# =============================================================================
# Offside Store — variables de entorno (PLANTILLA)
# =============================================================================
# Copiar a `.env` y completar. NUNCA commitear `.env` (CLAUDE.md §10).
# Referencia: docs/04-technical/tech-stack.md §4
#
# Leyenda:
#   [req]  requerida para levantar la app
#   [dev]  tiene default util solo para desarrollo local
#   [tbd]  todavia no se usa; el modulo correspondiente no esta implementado
#   [ext]  dependencia externa 🌐 — nombre/forma a confirmar contra doc oficial
# =============================================================================

# --- Aplicacion --------------------------------------------------------------
# NODE_ENV lo gestiona Next.js / el runtime; no se define aca.
APP_ENV=development                          # [req] development | test | production
APP_URL=http://localhost:3000                # [req] URL publica base de la app
LOG_LEVEL=debug                              # [dev] debug | info | warn | error

# --- PostgreSQL --------------------------------------------------------------
# [req] Coincide con los defaults de docker-compose.yml para desarrollo local.
DATABASE_URL=postgresql://offside:offside@localhost:5432/offside_dev

# --- Redis (cache + BullMQ) --------------------------------------------------
REDIS_URL=redis://localhost:6379             # [req]

# --- Almacenamiento S3 compatible --------------------------------------------
S3_ENDPOINT=                                 # [tbd]
S3_REGION=                                   # [tbd]
S3_BUCKET=                                   # [tbd]
S3_ACCESS_KEY=                               # [tbd] SECRETO
S3_SECRET_KEY=                               # [tbd] SECRETO

# --- Mercado Pago ------------------------------------------------------------
# Usar SIEMPRE credenciales de sandbox/test hasta que se decida el paso a
# produccion (tech-stack.md §5).
#
# ⚠️ SANDBOX vs PRODUCCION lo define la CREDENCIAL, no la URL: Mercado Pago usa
# los mismos endpoints en ambos ambientes. Para probar, se cargan aca las
# credenciales de TEST de la aplicacion y se opera con cuentas de prueba
# (vendedor y comprador) creadas en el panel. El codigo no cambia.
#
# [req para conectar vendedores] Las usa la conexion OAuth del modulo `sellers`.
# Se exigen al inicializar el cliente OAuth, no al arrancar la app.
# ⚠️ PKCE debe estar HABILITADO en la configuracion de la aplicacion en el panel
# de Mercado Pago: no alcanza con que Offside envie los parametros.
MERCADOPAGO_CLIENT_ID=                       # APP_ID de la aplicacion
MERCADOPAGO_CLIENT_SECRET=                   # SECRETO
# ⚠️ Debe coincidir EXACTAMENTE con la "Redirect URI" registrada en la
# aplicacion de Mercado Pago. NO se deriva de APP_URL: un fallback silencioso
# convertiria un error de configuracion en un rechazo remoto opaco.
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/sellers/mercadopago/callback
#
# [req para cobrar] SECRETO — valida la firma de los webhooks de pago. Se genera
# en el panel de Mercado Pago al configurar la notificacion. Sin el, el endpoint
# de webhook rechaza TODO (falla cerrado).
MERCADOPAGO_WEBHOOK_SECRET=
#
# [tbd] Credencial de la aplicacion/marketplace. Payments usa el token DEL
# VENDEDOR (Split 1:1), asi que hoy no hace falta.
MERCADOPAGO_ACCESS_TOKEN=                    # [tbd] SECRETO

# --- Correo Argentino --------------------------------------------------------
# [tbd][ext] 🔵 El nombre real de la/s variable/s depende de su API, que todavia
# no fue investigada (DEC-006). No asumir forma ni endpoints.
CORREO_ARGENTINO_API_KEY=                    # [tbd] SECRETO

# --- Seguridad ---------------------------------------------------------------
# [req] SECRETO — firma de sesiones de la auth propia de Offside. El modulo
# `auth` ya esta implementado: sin esto no se puede iniciar sesion.
#   Generar con:  openssl rand -base64 32
AUTH_SESSION_SECRET=

# [req para conectar vendedores] SECRETO — cifrado en reposo (AES-256-GCM) de
# los tokens OAuth de vendedores (tech-stack.md §3.5).
# Deben ser 32 bytes. Generar con:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Parametros operables de auth ------------------------------------------
# [dev] SEGURIDAD, no reglas de negocio. La comision, las ventanas de pago /
# cancelacion / refund y los limites del marketplace NO van aca: pertenecen al
# Config Store administrativo (app_settings) y siguen pendientes de decision.
AUTH_SESSION_TTL_HOURS=168                   # vida de la sesion (7 dias)
AUTH_PASSWORD_MIN_LENGTH=12                  # minimo de caracteres de password
AUTH_EMAIL_TOKEN_TTL_HOURS=24                # vida del token de verificacion de email
AUTH_PASSWORD_RESET_TTL_HOURS=1              # vida del token de reset de password

# Rate limiting de los endpoints de auth no autenticados (Redis).
# 🟡 Valores PROVISORIOS, pendientes de confirmacion del owner.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15            # ventana de conteo
AUTH_RATE_LIMIT_MAX_PER_IP=20                # intentos por IP y ventana
AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=5            # intentos FALLIDOS por cuenta y ventana
