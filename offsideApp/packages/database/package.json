    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@offside/config": "*",
    "@offside/utils": "*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
