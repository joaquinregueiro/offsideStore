# Reglas del repositorio.
# Los artefactos de build y dependencias del monorepo se ignoran desde
# `offsideApp/.gitignore`, junto al codigo que los produce.

# === Entorno (NUNCA commitear secretos — CLAUDE.md §10) ===
.env
.env.*
!.env.example

# === Editor / OS ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# === Logs ===
*.log
